# Base44 local placeholders — app boots without any real credentials.
# Real secrets (when provided) are delivered via /run/base44/app.env and override these.

# Flask session/CSRF signing key (dev placeholder only).
SECRET_KEY=base44-dev-secret-key-change-me
# Development mode => session cookies work over the preview proxy (no HTTPS-only).
FLASK_ENV=development
# Auto-seed demo students/teachers/courses on first boot.
SEED_DEMO=true
# Documented demo admin login (admin / admin123).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
