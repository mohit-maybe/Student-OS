# Copy this file to .env and fill in real values before running the app.

# Flask
SECRET_KEY=change-this-to-a-long-random-secret
FLASK_ENV=development

# Database: leave DATABASE_URL unset to use local SQLite (file set by DATABASE below).
# Set DATABASE_URL to a postgres:// URL to use PostgreSQL instead.
DATABASE=student_os.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# First-run admin account (created automatically on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Outgoing mail (password reset, verification emails) - Flask-Mail/SMTP
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Optional: Brevo transactional email API (used for some admissions/staff notifications)
# BREVO_API_KEY=
# SENDER_EMAIL=
# SENDER_NAME=Student OS

# Optional: seed demo data on first run (default: enabled on empty DB)
# SEED_DEMO=true
